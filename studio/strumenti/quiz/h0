<style>:root{--bg: #0e1218;--surface: #161c25;--surface-2: #1d2531;--line: #2b3544;--ink: #e7ecf2;--muted: #94a1b3;--accent: #62cde3;--accent-ink: #06222a;--ok: #5fd38d;--ok-bg: #12301f;--bad: #ff8a80;--bad-bg: #3a1a1a;--warn: #f2b84b;--display: "Bricolage Grotesque", "Avenir Next", "Segoe UI", system-ui, sans-serif;--body: "IBM Plex Sans", system-ui, -apple-system, "Segoe UI", sans-serif;--mono: "IBM Plex Mono", ui-monospace, "SF Mono", Menlo, monospace;color-scheme:dark}@media(prefers-color-scheme:light){:root:not([data-theme=dark]){--bg: #eef2f6;--surface: #ffffff;--surface-2: #e5ebf2;--line: #cdd7e2;--ink: #101820;--muted: #536074;--accent: #0b7a94;--accent-ink: #ffffff;--ok: #17703e;--ok-bg: #dcf3e5;--bad: #b3261e;--bad-bg: #fbe3e0;--warn: #9a6700;color-scheme:light}}:root[data-theme=light]{--bg: #eef2f6;--surface: #ffffff;--surface-2: #e5ebf2;--line: #cdd7e2;--ink: #101820;--muted: #536074;--accent: #0b7a94;--accent-ink: #ffffff;--ok: #17703e;--ok-bg: #dcf3e5;--bad: #b3261e;--bad-bg: #fbe3e0;--warn: #9a6700;color-scheme:light}*{box-sizing:border-box}html{-webkit-text-size-adjust:100%}body{margin:0;background:var(--bg);color:var(--ink);font:400 16px/1.5 var(--body);padding-block:22px 56px;padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px))}.wrap{max-width:640px;margin:0 auto;display:grid;gap:18px;min-width:0}header{display:grid;gap:6px}.eyebrow{margin:0;font:500 12px/1.3 var(--mono);letter-spacing:.09em;text-transform:uppercase;color:var(--accent)}h1{margin:0;font:700 clamp(28px,8vw,38px)/1.08 var(--display);letter-spacing:-.01em;text-wrap:balance}.focus{margin:0;color:var(--muted);font-size:15px}.src{margin:2px 0 0;color:var(--muted);font:400 12px/1.5 var(--mono)}.meter{display:grid;grid-template-columns:repeat(var(--n),1fr);gap:4px}.tick{height:10px;border-radius:2px;background:var(--line)}.tick.now{background:var(--accent)}.tick.ok{background:var(--ok)}.tick.bad{background:var(--bad)}.stat{display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;margin-top:8px;font:400 13px/1.3 var(--mono);color:var(--muted);font-variant-numeric:tabular-nums}.stat b{color:var(--ink);font-weight:500}.card{background:var(--surface);border:1px solid var(--line);border-radius:14px;padding:18px;display:grid;gap:16px;min-width:0;margin-top:14px}.qhead{display:flex;align-items:center;gap:10px;flex-wrap:wrap;font:400 12px/1 var(--mono);letter-spacing:.06em;text-transform:uppercase;color:var(--muted)}.badge{padding:5px 9px;border-radius:999px;border:1px solid var(--line);color:var(--ink)}.badge.lv-Applicativo{border-color:var(--accent);color:var(--accent)}.badge.lv-Trabocchetto{border-color:var(--warn);color:var(--warn)}.badge.lv-Problema{border-color:var(--ok);color:var(--ok)}.badge.lv-Completamento{background:var(--accent);border-color:var(--accent);color:var(--accent-ink)}.question{margin:0;font:500 18px/1.5 var(--body);text-wrap:pretty;overflow-wrap:anywhere}.opts{display:grid;gap:10px}.opt{display:grid;grid-template-columns:30px 1fr;gap:12px;align-items:start;width:100%;min-height:48px;padding:11px 13px;text-align:left;background:var(--surface-2);color:var(--ink);border:1px solid var(--line);border-radius:10px;font:400 16px/1.4 var(--body);cursor:pointer;min-width:0}.opt .key{display:grid;place-items:center;width:28px;height:28px;border-radius:6px;background:var(--bg);border:1px solid var(--line);font:500 13px/1 var(--mono)}.opt .txt{overflow-wrap:anywhere;padding-top:3px}.opt .tag{display:block;margin-top:4px;font:500 12px/1.2 var(--mono);letter-spacing:.05em;text-transform:uppercase}@media(hover:hover){.opt:not(:disabled):hover{border-color:var(--accent)}}.opt:disabled{cursor:default}.opt.ok{background:var(--ok-bg);border-color:var(--ok)}.opt.ok .key{background:var(--ok);border-color:var(--ok);color:var(--bg)}.opt.ok .tag{color:var(--ok)}.opt.bad{background:var(--bad-bg);border-color:var(--bad)}.opt.bad .key{background:var(--bad);border-color:var(--bad);color:var(--bg)}.opt.bad .tag{color:var(--bad)}.opt.dim{opacity:.62}.fillform{display:grid;gap:10px}.fillform label{font:500 12px/1.2 var(--mono);letter-spacing:.08em;text-transform:uppercase;color:var(--muted)}.fillform input{width:100%;padding:12px 13px;min-height:48px;background:var(--surface-2);color:var(--ink);border:1px solid var(--line);border-radius:10px;font:500 16px/1.3 var(--mono)}.fillform input.ok{border-color:var(--ok);background:var(--ok-bg)}.fillform input.bad{border-color:var(--bad);background:var(--bad-bg)}.fillform input:disabled{opacity:1;-webkit-text-fill-color:var(--ink)}.hint{margin:0;color:var(--muted);font-size:14px}:focus-visible{outline:2px solid var(--accent);outline-offset:2px}.why{background:var(--surface-2);border:1px solid var(--line);border-radius:10px;padding:14px;display:grid;gap:6px}.why .label{font:500 12px/1.2 var(--mono);letter-spacing:.08em;text-transform:uppercase;color:var(--muted)}.why .verdict{margin:0;font:600 16px/1.35 var(--body)}.why .verdict.ok{color:var(--ok)}.why .verdict.bad{color:var(--bad)}.why p{margin:0;overflow-wrap:anywhere}.btn{display:block;width:100%;padding:14px 16px;border-radius:10px;border:1px solid var(--accent);background:var(--accent);color:var(--accent-ink);font:600 16px/1.2 var(--body);cursor:pointer}.btn.ghost{background:transparent;color:var(--accent)}.score{display:grid;gap:4px}.score .big{font:700 clamp(52px,16vw,76px)/1 var(--display);font-variant-numeric:tabular-nums}.score .big small{font-size:.45em;color:var(--muted);font-weight:600}.score .pct{font:500 14px/1.3 var(--mono);color:var(--muted)}.score .msg{margin:6px 0 0;font-size:17px}.levels{display:grid;gap:10px}.weak{margin:4px 0 0;font:400 14px/1.45 var(--body)}.weak b{font-weight:600}.lvrow{display:grid;grid-template-columns:112px 1fr 44px;gap:10px;align-items:center;font:400 13px/1.2 var(--mono)}.lvrow .bar{height:10px;border-radius:2px;background:var(--line);overflow:hidden}.lvrow .fill{height:100%;background:var(--accent)}.lvrow .n{text-align:right;font-variant-numeric:tabular-nums}h2{margin:0;font:600 13px/1.2 var(--mono);letter-spacing:.08em;text-transform:uppercase;color:var(--muted)}.review{display:grid;gap:10px}details{background:var(--surface-2);border:1px solid var(--line);border-radius:10px;padding:12px 14px;min-width:0}summary{cursor:pointer;font:500 14px/1.4 var(--body);overflow-wrap:anywhere}details .inner{display:grid;gap:8px;margin-top:10px}details .inner p{margin:0;overflow-wrap:anywhere}.pair{font:400 13px/1.45 var(--mono)}.pair b{font-weight:500}.pair .r{color:var(--ok)}.pair .w{color:var(--bad)}.actions{display:grid;gap:10px}@media(prefers-reduced-motion:no-preference){.fill{transition:width .4s ease}}
/* ===== estensione motore 07/11: immagini, navigazione, suggerimento, spiegazione ===== */
.tick{border:0;padding:0;cursor:pointer}.tick.cur{outline:2px solid var(--ink);outline-offset:1px}
.fig{margin:0;display:grid;gap:6px;background:var(--surface-2);border:1px solid var(--line);border-radius:10px;padding:10px}
.fig button{all:unset;cursor:zoom-in;display:block}.fig svg{display:block;width:100%;height:auto;max-height:230px}
.fig figcaption{font:400 12px/1.4 var(--mono);color:var(--muted)}
.tools{display:flex;gap:8px;flex-wrap:wrap}
.tool{flex:1 1 140px;min-height:44px;padding:10px 12px;border-radius:10px;border:1px solid var(--line);background:var(--surface-2);color:var(--ink);font:500 14px/1.2 var(--body);cursor:pointer}
.tool:disabled{opacity:.45;cursor:default}.tool.on{border-color:var(--accent);color:var(--accent)}
.opt.off{opacity:.28;text-decoration:line-through;cursor:not-allowed}
.expl{background:var(--surface-2);border:1px solid var(--accent);border-radius:10px;padding:14px;display:grid;gap:10px}
.expl .label{font:500 12px/1.2 var(--mono);letter-spacing:.08em;text-transform:uppercase;color:var(--accent)}
.expl blockquote{margin:0;padding:2px 0 2px 12px;border-left:3px solid var(--accent);font-style:italic;overflow-wrap:anywhere}
.expl .who{display:block;margin-top:6px;font:400 12px/1.4 var(--mono);color:var(--muted);font-style:normal}
.expl .who a{color:var(--accent)}
.expl .mine{border-top:1px dashed var(--line);padding-top:10px}
.expl .mine b{display:block;font:500 12px/1.2 var(--mono);letter-spacing:.08em;text-transform:uppercase;color:var(--muted);margin-bottom:4px}
.nav{display:grid;grid-template-columns:1fr 1fr;gap:10px}.nav .btn:disabled{opacity:.4;cursor:default}
.warnbox{background:var(--surface-2);border:1px solid var(--warn);border-radius:10px;padding:14px;display:grid;gap:10px}
.warnbox p{margin:0}
.zoom{position:fixed;inset:0;background:rgba(0,0,0,.82);display:grid;place-items:center;padding:16px;z-index:9;cursor:zoom-out}
.zoom .box{background:var(--surface);border-radius:12px;padding:12px;width:min(100%,900px)}
.zoom svg{width:100%;height:auto;display:block}
/* correzione passo-passo 07/11 sera */
.why .steps{margin:0;padding-left:22px;display:grid;gap:8px}.why .steps li{overflow-wrap:anywhere;line-height:1.5}.why .steps b{font-weight:600}
.wrongwhy{border-left:3px solid var(--bad);background:var(--bad-bg);border-radius:0 8px 8px 0;padding:10px 12px;display:grid;gap:4px}.wrongwhy b{color:var(--bad);font:600 13px/1.3 var(--mono);letter-spacing:.04em;text-transform:uppercase}
.others{background:var(--surface)}.others p b{font-weight:600}
details .inner .steps{margin:0;padding-left:22px;display:grid;gap:8px}
</style>
